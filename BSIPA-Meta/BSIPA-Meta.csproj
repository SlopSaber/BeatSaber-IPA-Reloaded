<Project Sdk="Microsoft.Build.NoTargets/3.7.0" DefaultTargets="Build">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <Platforms>x86;x64</Platforms>
    <Configurations>Debug;Release;Verbose;Verbose_Release</Configurations>
    <PackageAction>Assemble</PackageAction>
    <InnerTargets>Assemble</InnerTargets>
    <Platform Condition="'$(Platform)' == '' Or '$(Platform)' == 'AnyCPU'">x64</Platform>
  </PropertyGroup>

  <PropertyGroup>
    <OutputPath>$(MSBuildThisFileDirectory)bin\$(Platform)\$(Configuration)\net472\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <PackageZip>$(MSBuildThisFileDirectory)bin\$(Platform)\$(Configuration)\BSIPA.zip</PackageZip>
    <HistoricalArchive>$(MSBuildThisFileDirectory)..\CoreLibraries\HistoricalLibraries.zip</HistoricalArchive>
    <HistoricalCache>$(MSBuildThisFileDirectory)obj\historical\</HistoricalCache>
    <PackageInputList>$(MSBuildThisFileDirectory)obj\$(Platform)\$(Configuration)\package-inputs.txt</PackageInputList>
    <DoorstopVersion>4.5.0</DoorstopVersion>
    <DoorstopCache>$(MSBuildThisFileDirectory)obj\doorstop\$(DoorstopVersion)\</DoorstopCache>
    <DoorstopArchive>$(DoorstopCache)doorstop_win_release_$(DoorstopVersion).zip</DoorstopArchive>
    <DoorstopSourceArchive>$(DoorstopCache)doorstop-source-$(DoorstopVersion).zip</DoorstopSourceArchive>
    <DoorstopArchiveHash>7BB953E8D883C8BDE76CED96F6D0E45660AD6E0151880D8AB5856BF4F532B147</DoorstopArchiveHash>
    <DoorstopSourceHash>7F0C963104AA08BF5FEFEF8FF85E7FECD8306838F5AF3101487D9DB4E9188D63</DoorstopSourceHash>
    <NativeBootstrapSource>$(MSBuildThisFileDirectory)..\NativeBootstrap\</NativeBootstrapSource>
    <NativeBootstrapBuild>$(DoorstopCache)bsipa-$(Platform)\</NativeBootstrapBuild>
    <NativeBootstrapArchitecture Condition="'$(Platform)' == 'x64'">x64</NativeBootstrapArchitecture>
    <NativeBootstrapArchitecture Condition="'$(Platform)' == 'x86'">Win32</NativeBootstrapArchitecture>

    <IsVerbose>false</IsVerbose>
    <IsVerbose Condition="'$(Configuration)' == 'Verbose' Or '$(Configuration)' == 'Verbose_Release'">true</IsVerbose>

    <NoVerboseConfig>$(Configuration)</NoVerboseConfig>
    <NoVerboseConfig Condition="'$(IsVerbose)' == 'true' And '$(Configuration)' == 'Verbose'">Debug</NoVerboseConfig>
    <NoVerboseConfig Condition="'$(IsVerbose)' == 'true' And '$(Configuration)' == 'Verbose_Release'">Release</NoVerboseConfig>

    <InjectorOutputPath>$(MSBuildThisFileDirectory)..\IPA.Injector\bin\$(NoVerboseConfig)\net472\</InjectorOutputPath>
    <ConsoleHostOutputPath>$(MSBuildThisFileDirectory)..\IPA.Console\bin\$(NoVerboseConfig)\net472\</ConsoleHostOutputPath>
    <PackageExcludes Condition="'$(NoVerboseConfig)' == 'Release'">$(InjectorOutputPath)**\*.pdb</PackageExcludes>
  </PropertyGroup>

  <Import Project="..\CoreLibraries\HistoricalLibraries.props" />

  <ItemGroup>
    <ProjectReference Include="..\IPA.Console\IPA.Console.csproj" ReferenceOutputAssembly="false" Private="false">
      <SetConfiguration>Configuration=$(NoVerboseConfig)</SetConfiguration>
      <SetPlatform>Platform=AnyCPU</SetPlatform>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
    </ProjectReference>
    <ProjectReference Include="..\IPA.Injector\IPA.Injector.csproj" ReferenceOutputAssembly="false" Private="false">
      <SetConfiguration>Configuration=$(NoVerboseConfig)</SetConfiguration>
      <SetPlatform>Platform=AnyCPU</SetPlatform>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
    </ProjectReference>
    <ProjectReference Include="..\IPA.Loader\IPA.Loader.csproj" ReferenceOutputAssembly="false" Private="false">
      <SetConfiguration>Configuration=$(NoVerboseConfig)</SetConfiguration>
      <SetPlatform>Platform=AnyCPU</SetPlatform>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
    </ProjectReference>
  </ItemGroup>

  <Target Name="Clean">
    <ItemGroup>
      <Files Include="$(OutputPath)**\*" />
    </ItemGroup>
    <Delete Files="@(Files);$(PackageZip)" />
  </Target>

  <Target Name="PrepareDoorstop" Inputs="$(DoorstopArchive);$(DoorstopSourceArchive);$(MSBuildProjectFullPath)"
          Outputs="$(DoorstopCache)ready.stamp;$(DoorstopCache)windows\$(Platform)\winhttp.dll;$(DoorstopCache)source\UnityDoorstop-$(DoorstopVersion)\LICENSE">
    <Error Condition="'$(Platform)' != 'x64' And '$(Platform)' != 'x86'" Text="Windows packages require Platform=x64 or Platform=x86." />
    <MakeDir Directories="$(DoorstopCache)" />
    <DownloadFile Condition="!Exists('$(DoorstopArchive)')"
                  SourceUrl="https://github.com/NeighTools/UnityDoorstop/releases/download/v$(DoorstopVersion)/doorstop_win_release_$(DoorstopVersion).zip"
                  DestinationFolder="$(DoorstopCache)" DestinationFileName="doorstop_win_release_$(DoorstopVersion).zip" />
    <DownloadFile Condition="!Exists('$(DoorstopSourceArchive)')"
                  SourceUrl="https://codeload.github.com/NeighTools/UnityDoorstop/zip/refs/tags/v$(DoorstopVersion)"
                  DestinationFolder="$(DoorstopCache)" DestinationFileName="doorstop-source-$(DoorstopVersion).zip" />
    <GetFileHash Files="$(DoorstopArchive)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="DoorstopBinaryHash" />
    </GetFileHash>
    <GetFileHash Files="$(DoorstopSourceArchive)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="DoorstopSourceHashItem" />
    </GetFileHash>
    <Error Condition="'%(DoorstopBinaryHash.FileHash)' != '$(DoorstopArchiveHash)'" Text="Doorstop binary archive SHA-256 does not match the pinned release." />
    <Error Condition="'%(DoorstopSourceHashItem.FileHash)' != '$(DoorstopSourceHash)'" Text="Doorstop source archive SHA-256 does not match the pinned release." />
    <Unzip SourceFiles="$(DoorstopArchive)" DestinationFolder="$(DoorstopCache)windows" />
    <Unzip SourceFiles="$(DoorstopSourceArchive)" DestinationFolder="$(DoorstopCache)source" />
    <Touch Files="$(DoorstopCache)ready.stamp;$(DoorstopCache)windows\$(Platform)\winhttp.dll;$(DoorstopCache)source\UnityDoorstop-$(DoorstopVersion)\LICENSE" AlwaysCreate="true" />
  </Target>

  <Target Name="CheckHistoricalCache">
    <ItemGroup>
      <HistoricalCacheFile Include="@(HistoricalLibrary->'$(HistoricalCache)%(Source)')" />
      <MissingHistoricalFiles Include="@(HistoricalCacheFile)" Condition="!Exists('%(HistoricalCacheFile.Identity)')" />
    </ItemGroup>
    <Delete Files="$(HistoricalCache)ready.stamp" Condition="'@(MissingHistoricalFiles)' != ''" />
  </Target>

  <Target Name="PrepareHistoricalLibraries" DependsOnTargets="CheckHistoricalCache"
          Inputs="$(HistoricalArchive);$(HistoricalArchive).sha256;$(MSBuildProjectFullPath);$(MSBuildThisFileDirectory)..\CoreLibraries\HistoricalLibraries.props"
          Outputs="$(HistoricalCache)ready.stamp">
    <ReadLinesFromFile File="$(HistoricalArchive).sha256">
      <Output TaskParameter="Lines" ItemName="HistoricalLibraryDigest" />
    </ReadLinesFromFile>
    <GetFileHash Files="$(HistoricalArchive)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="HistoricalLibraryArchive" />
    </GetFileHash>
    <Error Condition="'%(HistoricalLibraryArchive.FileHash)' != '@(HistoricalLibraryDigest)'" Text="Historical core library archive SHA-256 does not match its recorded digest." />
    <Unzip SourceFiles="$(HistoricalArchive)" DestinationFolder="$(HistoricalCache)" />
    <Touch Files="$(HistoricalCache)ready.stamp" AlwaysCreate="true" />
  </Target>

  <Target Name="PrepareVersionLayout" Inputs="$(HistoricalArchive);$(MSBuildThisFileDirectory)..\CoreLibraries\HistoricalLibraries.props"
          Outputs="$(MSBuildThisFileDirectory)obj\$(Platform)\$(Configuration)\version-layout.stamp">
    <RemoveDir Directories="$(OutputPath)IPA\CoreLibraries\Versions" />
    <MakeDir Directories="$(MSBuildThisFileDirectory)obj\$(Platform)\$(Configuration)" />
    <Touch Files="$(MSBuildThisFileDirectory)obj\$(Platform)\$(Configuration)\version-layout.stamp" AlwaysCreate="true" />
  </Target>

  <Target Name="PrepareNativeBootstrap" DependsOnTargets="PrepareDoorstop"
          Inputs="$(DoorstopSourceArchive);$(NativeBootstrapSource)CMakeLists.txt;$(NativeBootstrapSource)fpfc.c;$(NativeBootstrapSource)fpfc.h"
          Outputs="$(NativeBootstrapBuild)$(Configuration)\winhttp.dll">
    <Exec Command="cmake -S &quot;$(NativeBootstrapSource).&quot; -B &quot;$(NativeBootstrapBuild).&quot; -A $(NativeBootstrapArchitecture) -DDOORSTOP_SOURCE_DIR=&quot;$(DoorstopCache)source/UnityDoorstop-$(DoorstopVersion)&quot;" />
    <Exec Command="cmake --build &quot;$(NativeBootstrapBuild).&quot; --config $(Configuration) --parallel" />
  </Target>

  <Target Name="GatherPackageInputs" DependsOnTargets="PrepareNativeBootstrap;PrepareHistoricalLibraries;PrepareVersionLayout">
    <ItemGroup>
      <ConsoleHostFile Include="$(ConsoleHostOutputPath)IPA.Console.exe*" />
      <PackageFile Include="@(ConsoleHostFile)"><TargetPath>IPA\Data\Managed\%(ConsoleHostFile.Filename)%(ConsoleHostFile.Extension)</TargetPath></PackageFile>
    </ItemGroup>
    <GetFileHash Files="@(BootstrapLibrary->'$(InjectorOutputPath)Libs\%(Identity)')" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="BootstrapLibraryHash" />
    </GetFileHash>
    <Error Condition="'%(BootstrapLibraryHash.FileHash)' != '%(BootstrapLibraryHash.ExpectedHash)'"
           Text="A shared core dependency changed. Regenerate CoreLibraries/HistoricalLibraries.zip with tools/build_core_libraries.py." />
    <Error Condition="!Exists('$(InjectorOutputPath)Data\Managed\IPA.Injector.dll') Or !Exists('$(InjectorOutputPath)Data\Managed\IPA.Loader.dll')"
           Text="The injector and loader output must exist before packaging." />
    <ItemGroup>
      <ManagedFiles Include="$(InjectorOutputPath)Data\Managed\**\*" Exclude="$(PackageExcludes)" />
      <LibraryFiles Include="$(InjectorOutputPath)Libs\**\*" Exclude="$(PackageExcludes)" />
      <PackageFile Include="@(ManagedFiles)">
        <TargetPath>IPA\Data\Managed\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
      </PackageFile>
      <PackageFile Include="@(LibraryFiles)">
        <TargetPath>IPA\CoreLibraries\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
      </PackageFile>
      <PackageFile Include="@(HistoricalLibrary->'$(HistoricalCache)%(Source)')" />
      <PackageFile Include="$(NativeBootstrapBuild)$(Configuration)\winhttp.dll"><TargetPath>winhttp.dll</TargetPath></PackageFile>
      <PackageFile Include="$(MSBuildThisFileDirectory)doorstop_config.ini"><TargetPath>doorstop_config.ini</TargetPath></PackageFile>
      <PackageFile Include="$(DoorstopCache)source\UnityDoorstop-$(DoorstopVersion)\LICENSE"><TargetPath>IPA\ThirdParty\Doorstop\LICENSE</TargetPath></PackageFile>
      <PackageFile Include="$(DoorstopSourceArchive)"><TargetPath>IPA\ThirdParty\Doorstop\doorstop-source-$(DoorstopVersion).zip</TargetPath></PackageFile>
      <BootstrapSource Include="$(NativeBootstrapSource)*" />
      <PackageFile Include="@(BootstrapSource)"><TargetPath>IPA\ThirdParty\Doorstop\BSIPA\%(Filename)%(Extension)</TargetPath></PackageFile>
      <ExpectedPackageFiles Include="@(PackageFile->'$(OutputPath)%(TargetPath)')" />
      <ObsoletePackageFiles Include="$(OutputPath)**\*" Exclude="@(ExpectedPackageFiles->'%(FullPath)')" />
      <MissingPackageFiles Include="@(ExpectedPackageFiles)" Condition="!Exists('%(ExpectedPackageFiles.FullPath)')" />
    </ItemGroup>
    <MakeDir Directories="$(MSBuildThisFileDirectory)obj\$(Platform)\$(Configuration)" />
    <WriteLinesToFile File="$(PackageInputList)" Lines="@(PackageFile->'%(Identity)|%(TargetPath)')" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <Touch Files="$(PackageInputList)" Condition="'@(MissingPackageFiles)' != '' Or '@(ObsoletePackageFiles)' != ''" />
  </Target>

  <Target Name="Assemble" AfterTargets="Build" DependsOnTargets="GatherPackageInputs" Returns="$(OutputPath)"
          Inputs="@(PackageFile);$(PackageInputList);$(MSBuildProjectFullPath)" Outputs="$(PackageZip)">
    <Message Text="Packing $(PackageZip)" Importance="High" />
    <Delete Files="@(ObsoletePackageFiles)" />
    <RemoveDir Directories="$(OutputPath)Libraries;$(OutputPath)Libs;$(OutputPath)IPA\CoreLibraries\Versions\NuGet;$(OutputPath)IPA\CoreLibraries\Versions\Upstream" />
    <Copy SourceFiles="@(PackageFile)" DestinationFiles="@(PackageFile->'$(OutputPath)%(TargetPath)')" SkipUnchangedFiles="true" />
    <ZipDirectory SourceDirectory="$(OutputPath)" DestinationFile="$(PackageZip)" Overwrite="true" />
    <Message Text="Package: $(PackageZip)" Importance="High" />
  </Target>

</Project>


<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="AtlasRhythm" value="https://nuget.pkg.github.com/Atlas-Rhythm/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="AtlasRhythm">
      <package pattern="Hive.Versioning.Standalone" />
    </packageSource>
  </packageSourceMapping>
</configuration>
